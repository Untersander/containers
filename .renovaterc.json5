{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Same setup as home-ops-internal, app rules from home-operations/containers
  extends: [
    'github>home-operations/renovate-presets#11.0.0',
    ':semanticCommits',
    ':timezone(Europe/Zurich)',
  ],
  baseBranchPatterns: [
    'main',
  ],
  labels: [
    'dependencies',
    'renovate',
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 5,
  rangeStrategy: 'bump',
  ignoreTests: true,
  customDatasources: {
    'servarr-develop': {
      defaultRegistryUrlTemplate: 'https://{{packageName}}.servarr.com/v1/update/develop/changes?os=linux&runtime=netcore',
      format: 'json',
      transformTemplates: [
        '{"releases":[{"version": $[0].version}]}',
      ],
    },
    // version= selects the major, this needs a bump for Sonarr 6
    'sonarr-develop': {
      defaultRegistryUrlTemplate: 'https://services.sonarr.tv/v1/update/develop/changes?os=linux&runtime=netcore&version=5.0',
      format: 'json',
      transformTemplates: [
        '{"releases":[{"version": $[0].version}]}',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process Annotations in Docker Bake',
      managerFilePatterns: [
        '/(^|/)docker-bake\\.hcl$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Renovate version in the Forgejo workflow (runs from npm)',
      managerFilePatterns: [
        '/^\\.forgejo/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'npx --yes renovate@(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'renovate',
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      description: 'Release Rules for App Updates, all of them in one commit (majors too): Renovate restarts only once per run, so separate branches could not all merge in one run',
      matchFileNames: [
        'apps/**',
      ],
      groupName: 'apps',
      additionalBranchPrefix: '',
      separateMajorMinor: false,
      commitBodyTable: true,
      commitMessageExtra: '',
      semanticCommitScope: 'apps',
      semanticCommitType: 'release',
    },
    {
      description: 'Sonarr, Radarr and Prowlarr tag their releases with a v prefix, pre-releases are skipped (apps/*-develop use the custom datasources)',
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'Prowlarr/Prowlarr',
        'Radarr/Radarr',
        'Sonarr/Sonarr',
      ],
      extractVersion: '^v(?<version>.+)$',
    },
    {
      description: 'Bazarr and SABnzbd pre-releases come from GitHub, their stable versions belong to apps/bazarr and apps/sabnzbd',
      matchDatasources: [
        'github-releases',
      ],
      matchFileNames: [
        'apps/bazarr-develop/**',
        'apps/sabnzbd-develop/**',
      ],
      ignoreUnstable: false,
      allowedVersions: '/(alpha|beta|rc)/i',
    },
    {
      description: 'Allowed Alpine Version for Base Images, a new Alpine also needs the alpine_3_xx repology names in docker-bake.hcl',
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        '**/Dockerfile',
      ],
      matchPackageNames: [
        '/alpine/',
      ],
      allowedVersions: '/^3\\.24\\./',
    },
    {
      description: 'Allowed Python Version for Base Images, the same minor as home-operations/containers',
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        '**/Dockerfile',
      ],
      matchPackageNames: [
        'docker.io/library/python',
      ],
      allowedVersions: '/^3\\.14\\./',
    },
    {
      description: 'show the tag alongside the short digest on digest-only updates',
      matchUpdateTypes: [
        'digest',
      ],
      commitMessageExtra: '({{#if newValue}}{{newValue}}: {{/if}}{{currentDigestShort}} ➔ {{newDigestShort}})',
    },
    {
      description: 'automerge all updates (branch automerge, no PR opened)',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
      ],
      automerge: true,
    },
    {
      description: 'Renovate itself and actions in the Forgejo workflows',
      matchFileNames: [
        '.forgejo/workflows/**',
      ],
      groupName: 'workflows',
      separateMajorMinor: false,
    },
  ],
}
